generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String         @id
  fullName  String         @default("") @map("full_name")
  role      String         @default("user")
  createdAt DateTime       @default(now()) @map("created_at")
  events    Event[]
  photos    Photo[]
  messages  Message[]
  likes     MessageLike[]
  regs      Registration[]

  @@map("profiles")
}

model Event {
  id              String         @id @default(uuid())
  title           String
  description     String         @default("")
  date            DateTime       @map("date") @db.Date
  time            String         @default("")
  location        String         @default("")
  maxParticipants Int            @default(0) @map("max_participants")
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  creator         Profile        @relation(fields: [createdBy], references: [id])
  regs            Registration[]

  @@map("events")
}

model Registration {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@map("registrations")
}

model Photo {
  id          String   @id @default(uuid())
  url         String
  description String   @default("")
  approved    Boolean  @default(false)
  uploadedBy  String   @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  uploader    Profile  @relation(fields: [uploadedBy], references: [id])
  @@map("photos")
}

model Message {
  id        String       @id @default(uuid())
  content   String
  parentId  String?      @map("parent_id")
  parent    Message?     @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Message[]    @relation("Replies")
  userId    String       @map("user_id")
  user      Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at")
  likes     MessageLike[]
  @@map("messages")
}

model MessageLike {
  id        String  @id @default(uuid())
  messageId String  @map("message_id")
  userId    String  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId])
  @@map("message_likes")
}
